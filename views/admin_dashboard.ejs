<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Panel admin · Rectificación UMA</title>
  <link rel="stylesheet" href="/css/uma-admin.css?v=1"/>
  <link rel="icon" type="image/jpeg" href="/images/umalogo1.jpg"/>
</head>
<body>
<div class="page">
  <div class="topbar top">
    <div class="brandrow">
      <img src="/images/umalogo1.jpg" alt="UMA"/>
      <span class="sep"></span>
      <span class="ttl">Rectificación de matrícula<span class="sub">Panel de administración</span></span>
    </div>
    <form method="POST" action="/admin/logout">
      <button type="submit" class="secondary">Cerrar sesión</button>
    </form>
  </div>

  <div class="grid two">
    <div class="box">
      <div class="top" style="margin-bottom:14px;">
        <h3>Rectificaciones</h3>
        <form class="search" method="GET" action="/admin">
          <input name="q" value="<%= q %>" placeholder="Buscar por código o nombre" aria-label="Buscar" />
          <button type="submit">Buscar</button>
        </form>
      </div>

      <div class="tablewrap">
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Código</th>
            <th>Nombre</th>
            <th>Periodo</th>
            <th>Detalle</th>
          </tr>
        </thead>
        <tbody>
          <% rects.forEach(r => { %>
            <tr>
              <%
            const rawDate = r.submitted_at || r.createdAt || r.created_at || r.at || null;
            const dt = rawDate ? new Date(rawDate) : null;
            const fechaTxt = (dt && !isNaN(dt.getTime()))
              ? dt.toLocaleString('es-PE')
              : "—";
          %>
              <td><%= fechaTxt %></td>
              <td><%= r.student?.code %></td>
              <td><%= r.student?.name %></td>
              <td><%= r.student?.period %></td>
              <td>
                <a href="/admin/rectifications/<%= r.id %>">Ver detalle</a>
              </td>
            </tr>
          <% }) %>
          <% if (!rects.length) { %><tr><td class="empty" colspan="5">No hay rectificaciones registradas.</td></tr><% } %>
        </tbody>
      </table>
      </div>
    </div>

    <div class="box">
      <h3>Ingresos recientes</h3>
      <div class="tablewrap">
      <table>
        <thead><tr><th>Fecha</th><th>Alumno</th><th>IP</th></tr></thead>
        <tbody>
          <% logins.forEach(l => { %>
            <tr>
              <td><%= new Date(l.at).toLocaleString('es-PE', { timeZone: 'America/Lima', hour12: false }) %></td>
              <td><%= l.student_code %></td>
              <td><%= l.ip %></td>
            </tr>
          <% }) %>
          <% if (!logins.length) { %><tr><td class="empty" colspan="3">Sin ingresos recientes.</td></tr><% } %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
</body>
</html>
